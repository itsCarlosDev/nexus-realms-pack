    DialogData:{
      DialogDataSet:[
        {
          Label:"default",
          Texts:[{
            Text:"Aquí puedes gastar tus monedas en materiales de construcción y decoración del Overworld. Tengo piedra, variantes de roca, deepslate, tuff, calcita, arcilla, madera, tierra, arena, grava, barro, musgo, cristal y bloques decorativos para construir sin perder horas reuniendo recursos básicos. Los materiales propios del Nether los gestiona el Expedicionario de los Realms."
          }],
          Buttons:[
            {
              Label:"open_builder_trade",
              Actions:[{
                ExecAsUser:1b,
                Type:"OPEN_TRADING_SCREEN",
                PermLevel:0,
                Id:[I;-1224104800,-484884337,-1320992317,1639884801]
